# ==============================================================
# HACKATHON TEAM RANDOMIZER BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Server Host
HOST=0.0.0.0

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/hackathon_randomizer

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars_123456
JWT_EXPIRES_IN=24h

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Admin Bootstrap Credentials (Used during initial setup/seed)
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@hackathon.edu
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
